# sysmon-v2 configuration — copy to your service env file or `export` before starting.
# Every value is optional; defaults shown.

# ── Network ─────────────────────────────────────────────────────────
SYSMON_PORT=4120
# Bind 127.0.0.1 when proxying through nginx; 0.0.0.0 to serve the LAN.
SYSMON_HOST=0.0.0.0
# Label used in API payloads and alert messages (defaults to hostname).
SYSMON_HOST_LABEL=vivo-v2029

# ── Polling / retention ─────────────────────────────────────────────
SYSMON_SAMPLE_INTERVAL_MS=10000
SYSMON_RETENTION_HOURS=48
SYSMON_FLUSH_INTERVAL_MS=30000
SYSMON_HISTORY_MAX_POINTS=17280

# ── Security ────────────────────────────────────────────────────────
# When set, all API routes require: Authorization: Bearer <token>
SYSMON_API_TOKEN=

# ── Alerting ────────────────────────────────────────────────────────
SYSMON_ALERTS=1
SYSMON_CPU_ALERT_PCT=90
SYSMON_MEM_ALERT_PCT=90
SYSMON_DISK_ALERT_PCT=90
SYSMON_TEMP_ALERT_C=80
# Consecutive breaching samples before an alert fires (hysteresis).
SYSMON_ALERT_CONSECUTIVE=3
# Minimum interval between re-notifications per alert kind.
SYSMON_ALERT_COOLDOWN_MS=600000

# ── Telegram ────────────────────────────────────────────────────────
# From @BotFather; chat id via the bot (e.g. message @userinfobot).
SYSMON_TELEGRAM_TOKEN=
SYSMON_TELEGRAM_CHAT_ID=

# ── Endpoint probes ─────────────────────────────────────────────────
# Format: name=host:port[:intervalSec],...  (intervalSec default 30, min 5)
#SYSMON_ENDPOINTS=gw=192.168.1.1:53:30,web=example.com:443:60

# ── Disks ───────────────────────────────────────────────────────────
#SYSMON_DISK_MOUNTS=/,/storage/emulated
# Where history.jsonl lives (defaults to <project>/data).
#SYSMON_HOME=/data/data/com.termux/files/home/sysmon-v2
